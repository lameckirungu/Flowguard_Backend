# Multi-stage Docker build for Flowguard Streamlit Dashboard
FROM python:3.13-slim AS builder

WORKDIR /app

COPY requirements-dashboard.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements-dashboard.txt

FROM python:3.13-slim AS runtime

RUN useradd --create-home --uid 1000 flowgard
WORKDIR /app

COPY --from=builder /install /usr/local
COPY --chown=flowgard:flowgard . /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    API_BASE_URL=http://api:8000

USER flowgard

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health')" || exit 1

CMD ["streamlit", "run", "streamlit_app/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
