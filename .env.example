# Copy to .env and fill in real values. app/core/config.py is the ONLY place
# that reads these — never call os.environ / os.getenv anywhere else.

APP_NAME=flowgard
ENVIRONMENT=development
DEBUG=true

# Single source of truth for the DB connection. Alembic's migrations/env.py
# imports app.core.config.settings and reuses this value — it never hardcodes
# a second connection string.
#
# TCP + password (typical for Docker/managed Postgres):
#   postgresql+psycopg://user:password@localhost:5432/flowgard
# Local Unix-socket + peer auth (typical for a native local Postgres install
# where your OS user is also a Postgres role — no host, no password):
#   postgresql+psycopg://user@/flowgard
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowgard

# Used only by the test suite (tests/conftest.py). Keep it a separate database
# from DATABASE_URL so tests never run against real data.
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/flowgard_test

# JWT auth (app/core/auth.py)
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lifetime of the one-shot token issued at first login for the forced
# password reset (app/core/auth.py).
JWT_RESET_TOKEN_EXPIRE_MINUTES=30

# Platform-admin bootstrap (scripts/seed_platform_admin.py). This is the
# single account that onboards tenants; every other account is invited.
PLATFORM_ADMIN_EMAIL=platform.admin@flow.com
PLATFORM_ADMIN_PASSWORD=Admin@123
PLATFORM_ADMIN_FULL_NAME=Platform Administrator

# Outbound SMTP (app/core/email.py) — delivers onboarding credentials to
# newly invited tenant admins and users. Leave SMTP_HOST empty in local
# dev to disable sending (onboarding endpoints will return 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@flowgard.local
SMTP_USE_TLS=true

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ALLOW_ORIGINS=http://localhost:3000

# ETL (app/etl/) — weather ingestion + simulator, not used by the rest of the app.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
SIMULATOR_INTERVAL_SECONDS=5
